# Discord user ID for Lanyard presence widget (used client-side)
# Get your Discord ID: https://support.discord.com/hc/en-us/articles/206346498
VITE_DISCORD_USER_ID=000000000000000000

# Twitch app credentials for server-side Helix API proxy
# Create an app: https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_twitch_client_id
TWITCH_CLIENT_SECRET=your_twitch_client_secret

# Server port
PORT=4569

# Status monitoring (optional)
# STATUS_APPS is a JSON array of apps/services to monitor. Examples:
# STATUS_APPS=[{"id":"valorank","name":"Valorank API","url":"https://api.deem.my/api/health"},{"id":"cs2","name":"CS2 API","url":"https://cs.deem.my/health"},{"id":"chatbox","name":"CHATBOX","url":"https://chatbox.deem.my/health"}]
STATUS_APPS=[]

# VPS monitoring (optional)
# Option A: HTTP endpoint (recommended if you run vps-monitor on your VPS)
# VPS_HEALTH_URL=https://vps.deem.my:3717/api/all
#
# Option B: TCP check
# VPS_HOST can be an IPv4, IPv6, or hostname. IPv6 literals work with or without brackets.
# If VPS_IPV4 is set, it is used as a fallback when the primary host fails.
VPS_HOST=
VPS_IPV4=
VPS_PORT=22
VPS_NAME=VPS
VPS_HEALTH_URL=
